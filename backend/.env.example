# Copy to .env for local dev only (do not commit .env)
# On Railway: Project → Variables → add the same keys

GROK_API_KEY=your_xai_api_key_here
GROK_MODEL=grok-4
GROK_API_URL=https://api.x.ai/v1/chat/completions

# Railway injects PORT automatically; optional locally:
# PORT=8000
# API_HOST=0.0.0.0
# API_PORT=8000

REQUEST_TIMEOUT=15
GROK_TIMEOUT=90
LOG_LEVEL=INFO
