# Copy to .env for local dev only (do not commit .env)
# On Railway: Project → Variables → add the same keys

GROK_API_KEY=your_xai_api_key_here
GROK_MODEL=grok-4
GROK_API_URL=https://api.x.ai/v1/chat/completions

# Railway injects PORT automatically; optional locally:
# PORT=8000
# API_HOST=0.0.0.0
# API_PORT=8000

REQUEST_TIMEOUT=20
GROK_CONNECT_TIMEOUT=20
GROK_TIMEOUT=120
ANALYZE_ROUTE_TIMEOUT=180
UVICORN_TIMEOUT_KEEP_ALIVE=120
UVICORN_TIMEOUT_GRACEFUL_SHUTDOWN=180
LOG_LEVEL=INFO

# Oracle Citadel — encrypt exchange secrets at rest (required in production)
# CITADEL_ENCRYPTION_KEY=your_long_random_secret_here
# BloFin API passphrase (demo fallback — set on Railway)
# BLOFIN_PASSPHRASE=your_blofin_demo_passphrase
# Live BloFin passphrase (Railway screenshot uses Blofin_Passpharse_live — typo supported)
# BLOFIN_PASSPHRASE_LIVE=your_blofin_live_passphrase
# Blofin_Passpharse_live=your_blofin_live_passphrase
# Persist exchange keys across Railway redeploys — mount a volume at /data and set:
# CITADEL_DATA_DIR=/data

# Daily analysis scheduler (Home + push notifications — unchanged by X posting)
# DAILY_ANALYSIS_ENABLED=true
# DAILY_ANALYSIS_TZ=America/Chicago
# DAILY_ANALYSIS_HOUR=7
# DAILY_ANALYSIS_MINUTE=30

# X (Twitter) — auto-post daily analysis thread (@OnChainOracleA)
# Requires OAuth 1.0a User Context (Bearer token alone cannot post tweets).
# X_DAILY_POST_ENABLED=true
# X_API_KEY=your_twitter_api_key
# X_API_SECRET=your_twitter_api_secret
# X_ACCESS_TOKEN=your_user_access_token
# X_ACCESS_TOKEN_SECRET=your_user_access_token_secret
# X_ACCOUNT_HANDLE=@OnChainOracleA
# X_DAILY_POST_COINS=BTC,ETH,SOL,XRP
# X_DAILY_POST_DELAY_SECONDS=120
# Optional Railway cron backup (POST /internal/cron/post_daily_x with header X-Cron-Secret)
# X_CRON_SECRET=long_random_secret

# Discord — daily BTC/ETH embeds to #🔮-oracle-vision (Incoming Webhook)
# Paste the webhook ONLY here / in Railway Variables — never commit it.
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# DISCORD_DAILY_ENABLED=true
# DISCORD_DAILY_COINS=BTC,ETH
# DISCORD_DAILY_POST_DELAY_SECONDS=120
# On deploy after 7:30 AM Chicago, posts today's batch immediately if not already sent.
# Optional: POST /internal/cron/post_daily_discord with header X-Cron-Secret
